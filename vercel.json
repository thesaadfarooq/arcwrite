{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/api/og-shared-story?token=:token"
    },
    {
      "source": "/((?!api/|@vite|@react-refresh|src/|node_modules/|@fs/).*)",
      "destination": "/index.html"
    }
  ]
}
