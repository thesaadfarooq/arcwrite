# Supabase (client-side, prefixed with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-side, used by API routes)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=

# Stripe — use sandbox (sk_test_) keys locally, live (sk_live_) in production
STRIPE_SECRET_KEY=

# Stripe product/price IDs — MUST match the environment (sandbox vs live)
# No hardcoded defaults; omitting these will cause tier resolution to default to "free"
STRIPE_PLUS_PRODUCT_ID=
STRIPE_PRO_PRODUCT_ID=
VITE_STRIPE_PLUS_PRICE_ID=
VITE_STRIPE_PRO_PRICE_ID=
VITE_STRIPE_PLUS_PRODUCT_ID=
VITE_STRIPE_PRO_PRODUCT_ID=

# Neon Postgres (Vercel Marketplace) — use the arcwrite_dev database locally, neondb in production
DATABASE_URL=
